# Supabase
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Observability (optional — leave empty to disable)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Server-side (.env.local) — NUNCA commitar valores. Usados pelos scripts em
# scripts/*.mjs. As mesmas chaves precisam existir como secrets da edge
# function no Supabase:  supabase secrets set CHAVE=valor
# ---------------------------------------------------------------------------

# Supabase admin (service role — bypassa RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app. Usada pela pulse-dispatch para montar o CTA do e-mail e
# o link no Slack. Se ficar vazia, o disparo funciona mas sai SEM botão/link.
APP_BASE_URL=https://oxypeople20.vercel.app

# E-mail transacional via webhook n8n (entrega pelo Gmail o2@o2inc.com.br)
N8N_ENPS_WEBHOOK_URL=
N8N_ENPS_SECRET=

# Slack — DM individual + post no canal
SLACK_BOT_TOKEN=
PULSE_SLACK_CHANNEL_ID=

# Pipefy — só para scripts/create-missing-15.mjs (importa o database Pessoas)
PIPEFY_TOKEN=
